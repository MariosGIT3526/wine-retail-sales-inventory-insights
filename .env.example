# Copy this file to .env for local runs. Never commit .env.
SOCRATA_APP_TOKEN=

# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler"
PGHOST=aws-0-us-west-1.pooler.supabase.com
PGPORT=5432
PGUSER=postgres.yourprojectref
PGPASSWORD=
PGDATABASE=postgres
PGSSLMODE=require
DBT_PROFILES_DIR=./dbt
